rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() && exists(/databases/$(db)/documents/families/$(fid)/devices/$(request.auth.uid));
    }

    // 家族コード → 家族ID。コードを知っている人だけが1件ずつ読める（一覧は不可）
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if isMember(request.resource.data.fid);
    }

    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow read, update: if isMember(fid);

      // この家族につながっている端末
      match /devices/{uid} {
        allow read: if isMember(fid);
        allow create: if request.auth.uid == uid && (
          get(/databases/$(db)/documents/families/$(fid)).data.owner == uid ||
          get(/databases/$(db)/documents/joinCodes/$(request.resource.data.code)).data.fid == fid
        );
        allow update: if request.auth.uid == uid && !('code' in request.resource.data.diff(resource.data).affectedKeys());
        allow delete: if isMember(fid);
      }

      match /routines/{id} { allow read, write: if isMember(fid); }
      match /logs/{id}     { allow read, write: if isMember(fid); }
      match /points/{id}   { allow read, write: if isMember(fid); }
      match /timers/{id}   { allow read, write: if isMember(fid); }
    }
  }
}
